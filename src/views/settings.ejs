<%- include('partials/head', { title: 'Innstillinger', user }) %>

<h1>Innstillinger og Claude-tilkobling</h1>

<section class="panel">
  <h2>Din bruker</h2>
  <p><%= user.name %> · <%= user.email %> · rolle: <%= user.role %></p>
  <p class="muted small">Innlogging: e-post/passord<%= ssoConfigured ? ' eller Microsoft 365 SSO' : '' %></p>
  <button class="linklike" onclick="changeMyPassword()">Endre mitt passord</button>
</section>

<% if (user.role === 'admin') { %>
<section class="panel">
  <h2>Brukere</h2>
  <table class="data">
    <tr><th>E-post</th><th>Navn</th><th>Rolle</th><th>Passord</th><th></th></tr>
    <% for (const u of users) { %>
      <tr>
        <td><%= u.email %></td><td><%= u.name %></td><td><%= u.role %></td>
        <td><%= u.has_password ? 'Satt' : '–' %></td>
        <td><button class="linklike small" onclick="resetPassword(<%= u.id %>, '<%= u.email %>')">tilbakestill passord</button></td>
      </tr>
    <% } %>
  </table>
  <h3>Opprett bruker</h3>
  <form id="newUser" class="grid2" style="max-width:600px">
    <label>E-post <input type="email" name="email" required></label>
    <label>Navn <input name="name"></label>
    <label>Passord (minst 8 tegn) <input type="password" name="password" required minlength="8"></label>
    <label>Rolle <select name="role"><option value="kontrollor">Kontrollør</option><option value="admin">Admin</option></select></label>
    <button class="btn primary">Opprett bruker</button>
  </form>
</section>
<% } %>

<section class="panel">
  <h2>MCP-tilkobling for Claude</h2>
  <p>Claude kobles til dette systemet som en MCP-server og kan da opprette prosjekter, fylle ut sjekklister,
     registrere avvik og utarbeide rapportutkast – med full sporbarhet i aktivitetsloggen.</p>
  <table class="data">
    <tr><th>Endepunkt</th><td><code><%= baseUrl %>/mcp</code></td></tr>
    <tr><th>Autentisering</th><td><code>Authorization: Bearer &lt;din API-nøkkel&gt;</code></td></tr>
    <tr><th>Din API-nøkkel</th><td>
      <code id="apikey"><%= user.api_key %></code>
      <button class="linklike" onclick="navigator.clipboard.writeText(document.getElementById('apikey').textContent)">kopier</button>
      <button class="linklike" onclick="regen()">generer ny</button>
    </td></tr>
  </table>
  <p class="muted small">Nøkkelen er personlig. Genererer du ny, slutter den gamle å virke.</p>

  <h3>Claude Desktop / Claude Code</h3>
  <pre class="code">{
  "mcpServers": {
    "byggkon-uk": {
      "command": "npx",
      "args": [
        "-y", "mcp-remote", "<%= baseUrl %>/mcp",
        "--header", "Authorization: Bearer <%= user.api_key %>"
      ]
    }
  }
}</pre>
  <p class="muted small">Claude Code: <code>claude mcp add byggkon-uk --transport http <%= baseUrl %>/mcp --header "Authorization: Bearer &lt;nøkkel&gt;"</code></p>

  <h3>Verktøy Claude får</h3>
  <p class="muted">uk_veiledning, list_projects, get_project, create_project, set_stage, update_checkpoint,
     add_checkpoint, create_avvik, update_avvik, register_document, get_report_data, save_report, get_activity.</p>
</section>

<script>
async function post(url, body) {
  const r = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
  const d = await r.json().catch(() => ({}));
  if (!r.ok) { alert(d.error || 'Noe gikk galt'); return false; }
  return true;
}
async function changeMyPassword() {
  const current_password = prompt('Nåværende passord (tomt hvis du ikke har satt noe):') ?? '';
  const password = prompt('Nytt passord (minst 8 tegn):');
  if (password && await post('/api/me/password', { current_password, password })) alert('Passord endret.');
}
async function resetPassword(id, email) {
  const password = prompt('Nytt passord for ' + email + ' (minst 8 tegn):');
  if (password && await post('/api/users/' + id + '/password', { password })) alert('Passord tilbakestilt.');
}
const nu = document.getElementById('newUser');
if (nu) nu.addEventListener('submit', async (e) => {
  e.preventDefault();
  const data = Object.fromEntries(new FormData(nu).entries());
  if (await post('/api/users', data)) location.reload();
});
async function regen() {
  if (!confirm('Generere ny API-nøkkel? Den gamle slutter å virke.')) return;
  const r = await fetch('/api/me/apikey', { method: 'POST' });
  const d = await r.json();
  document.getElementById('apikey').textContent = d.api_key;
  alert('Ny nøkkel generert. Oppdater Claude-konfigurasjonen.');
}
</script>
<%- include('partials/foot') %>
