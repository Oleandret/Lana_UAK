<%- include('partials/head', { title: 'Logg inn', user: null }) %>
<div class="login-wrap">
  <div class="login-card">
    <div class="brand big">BYGG-KON</div>
    <h1>Uavhengig kontroll</h1>
    <p class="muted">Prosjektstyring og AI-assistert kontroll iht. SAK10 § 14-7</p>
    <% if (error) { %><div class="alert"><%= error %></div><% } %>

    <form method="post" action="/auth/local">
      <label>E-post <input type="email" name="email" required placeholder="navn@byggkon.no"></label>
      <label>Passord <input type="password" name="password" required></label>
      <button class="btn primary block">Logg inn</button>
    </form>

    <% if (sso) { %>
      <div class="divider">eller</div>
      <a class="btn block" href="/auth/microsoft">Logg inn med Microsoft 365</a>
    <% } %>

    <% if (adminLogin) { %>
      <details class="admin-login">
        <summary>Administrator-innlogging</summary>
        <form method="post" action="/auth/admin">
          <label>Admin-passord <input type="password" name="password" required></label>
          <button class="btn block">Logg inn som administrator</button>
        </form>
      </details>
    <% } %>

    <p class="muted small">Brukerkontoer opprettes av administrator under Innstillinger.</p>
  </div>
</div>
<%- include('partials/foot') %>
