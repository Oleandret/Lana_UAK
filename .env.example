# Påkrevd i produksjon
BASE_URL=https://uk.byggkon.no          # Appens offentlige URL (Railway-domenet)
SESSION_SECRET=                          # Lang tilfeldig streng

# Microsoft 365 SSO (Entra ID) – appen faller tilbake til dev-innlogging hvis tomme
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
ALLOWED_DOMAINS=byggkon.no               # Kommaseparert liste over tillatte e-postdomener

# Database (sett til volum-sti på Railway, f.eks. /data/byggkon-uk.db)
DB_PATH=./data/byggkon-uk.db

PORT=3000
